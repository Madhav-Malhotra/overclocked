# define the host and port of the webserver
# local testing (without board connected) will use a docker container with port forwarding.
HOST=localhost
PORT=8080

# PYNQ-Z2 connected to laptop
# board's default static IP is 192.168.2.99
# requires setting a static IP address for your laptop https://pynq.readthedocs.io/en/v2.5.1/appendix.html#assign-your-computer-a-static-ip
#HOST=192.168.2.99
#PORT=8080

# PYNQ-Z2 connected to the internet (ethernet port)
# requires finding the dynamic IP address assigned to the FPGA board.
# 1. connect to board via UART (micro-USB cable), run `ifconfig`
#HOST=""
#PORT=8080
