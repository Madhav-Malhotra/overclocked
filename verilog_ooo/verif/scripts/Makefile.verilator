# Verilator build rules for the OoO core (included by Makefile).
# Adapted from verilog/verif/scripts/Makefile.verilator. RTL file list comes
# from verif/scripts/design.f (same location as verilog/ and verilog_ss/; also used by `make lint`).

SRCLIST = $(shell grep -v '^\s*\#' $(CL_ROOT)/verif/scripts/design.f | grep -v '^\s*$$')
SRC = $(addprefix $(CL_ROOT)/design/code/, $(SRCLIST)) $(CL_ROOT)/verif/tests/clockgen.sv $(CL_ROOT)/design/design_wrapper.v
VFLAGS = -Wno-fatal
TOP = top
_CFLAGS=-DMEM_DEPTH=$(MEM_DEPTH) -DMEM_PATH=$(MEM_PATH_STR)

VCD ?= 0

# Setup VCD flags for verilator
ifeq ($(VCD), 1)
VFLAGS+= --trace
_CFLAGS+= -DVCD -DVCD_FILE=$(VCD_FILE_STR)
endif

ifneq ($(_CFLAGS), )
CFLAGS=$(addprefix -CFLAGS ,$(_CFLAGS))
endif

ifeq (,$(shell which verilator 2>/dev/null))
  $(error ERROR: verilator not found in PATH)
endif

compile: $(SRC) $(CL_ROOT)/verif/tests/tracegen.v $(CL_ROOT)/verif/tests/trace_dump.h $(CL_ROOT)/design/signals.h
	@echo "Verilator Compilation ($(notdir $(MEM_PATH)))"
	mkdir -p $(SIM_DIR)
	cd $(SIM_DIR) && verilator $(VFLAGS) \
		+1800-2012ext+sv \
		+1364-2005ext+v \
		$(CFLAGS) \
		--cc $(SRC) \
		$(TEST_NAME).sv \
		--exe $(TEST_NAME).cpp  \
		-I$(CL_ROOT)/design \
		-I$(CL_ROOT)/design/code \
		-I$(CL_ROOT)/verif/tests \
		-top-module $(TOP) \
		--Mdir $(SIM_DIR) \
		--public-flat-rw \
		+define+MEM_PATH=$(MEM_PATH_STR) \
		+define+MEM_DEPTH=$(MEM_DEPTH) \
		+define+GEN_TRACE=$(GEN_TRACE) \
		+define+TRACE_FILE=$(TRACE_FILE_STR)\
		+define+LINE_COUNT=$(LINE_COUNT) \
		+define+TIMEOUT=$(TIMEOUT) \
		$(WARN_OUTPUT)
	$(WARN_CHECK)
	$(MAKE) -C $(SIM_DIR) -f V$(TOP).mk V$(TOP)

run: compile
	@echo "Verilator Run ($(notdir $(MEM_PATH)))"
	cd $(SIM_DIR) && ./V$(TOP)
	@echo "Trace: $(SIM_DIR)/$(TRACE_FILE)"

waves:
	- $(MAKE) -s run MEM_PATH=$(MEM_PATH) VCD=1
	cd $(SIM_DIR) && gtkwave $(basename $(notdir $(MEM_PATH))).vcd $(SCRIPTS_DIR)/format.gtkw

clean:
	rm -rf $(SIM_ROOT)
